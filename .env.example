# --- Discord ---
DISCORD_TOKEN=
# Identifiant du serveur (clic droit sur le serveur > Copier l'identifiant, mode développeur activé)
GUILD_ID=
# Identifiant du rôle « Étudiant vérifié »
VERIFIED_ROLE_ID=
# Salon privé des modérateurs pour les logs (optionnel, laisser vide pour désactiver)
LOG_CHANNEL_ID=

# --- Vérification ---
# Domaines acceptés, séparés par des virgules (correspondance exacte, sans le @)
# Ex. : ALLOWED_DOMAINS=truc.fr,etu.truc.fr
ALLOWED_DOMAINS=truc.fr
# Clé secrète des empreintes. Générer avec : openssl rand -hex 32
# ⚠️ À sauvegarder dans un gestionnaire de mots de passe, JAMAIS avec la base.
# La perdre rend toutes les vérifications existantes inutilisables.
HMAC_SECRET=

# --- Gmail (compte réservé au bot, TOUS ses mails sont purgés) ---
GMAIL_USER=
# Mot de passe d'application (16 caractères), pas le mot de passe du compte
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Vérification Discord

# --- Limites (valeurs par défaut) ---
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
MAX_MAILS_PER_MEMBER_PER_DAY=5
PURGE_INTERVAL_MINUTES=60

# Chemin de la base (déjà réglé à /data/verification.sqlite dans Docker)
# DB_PATH=./data/verification.sqlite
